// Alloy: colector único de logs, trazas y métricas.

// ------------------------------------------------------------------ logs
// stdout de los contenedores de este proyecto compose -> Loki.
// Etiquetas SOLO de baja cardinalidad: service, container, level.
// correlation_id y reference NUNCA son etiquetas: se filtran por contenido
// ({service="worker"} |= "<correlation_id>" o | json | correlation_id="...").

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "compose" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "rpa(-.+)?" // proyecto compose "rpa" (o "rpa-smoke", etc.)
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "compose" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.compose.output
  forward_to = [loki.process.json.receiver]
}

loki.process "json" {
  // Los logs del worker son JSON: se extrae solo el nivel como etiqueta.
  stage.json {
    expressions = { level = "level" }
  }
  stage.labels {
    values = { level = "" }
  }
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// --------------------------------------------------------- trazas/métricas
otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  output {
    metrics = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    metrics = [otelcol.exporter.otlphttp.prometheus.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

// Prometheus 3 recibe OTLP en /api/v1/otlp (flag --web.enable-otlp-receiver);
// el exportador añade /v1/metrics.
otelcol.exporter.otlphttp "prometheus" {
  client {
    endpoint = "http://prometheus:9090/api/v1/otlp"
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
