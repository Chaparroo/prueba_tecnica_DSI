# Copia a .env (ignorado por git) y cambia TODOS los valores.
# Estos ejemplos son solo para desarrollo local.

# --- Ejecución local fuera de Docker (uv run rpa-worker ...) ---
RPA_CONFIG_PATH=config/config.yaml
REDIS_URL=redis://:change-me-redis@localhost:6379/0
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Compartido con docker compose ---
POSTGRES_DB=rpa
POSTGRES_USER=rpa
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis

# Puerto del host para /livez y /readyz del worker.
WORKER_HEALTH_PORT=8080

# --- Observabilidad (docker-compose.observability.yml) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
